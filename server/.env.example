# Generate independent secrets with setup.py. Never share your real .env.
VEGLIA_TOKEN=
VEGLIA_PHONE_TOKEN=
VEGLIA_SENSOR_TOKEN=
VEGLIA_MCP_TOKEN=
VEGLIA_MCP_READ_TOKEN=
VEGLIA_OAUTH_PASSWORD=

# Core is accessed by phones and sensors on the trusted LAN.
VEGLIA_HOST=0.0.0.0
VEGLIA_PORT=8513
VEGLIA_URL=http://127.0.0.1:8513
VEGLIA_HUB_URL=http://127.0.0.1:8513
VEGLIA_KEEP=5
VEGLIA_DEVICE_ID=desktop-pc
VEGLIA_DEVICE_NAME=My computer
VEGLIA_DEVICE_TYPE=windows_pc

# Keep the authenticated MCP bound to loopback for a same-machine tunnel.
VEGLIA_MCP_HOST=127.0.0.1
VEGLIA_MCP_PORT=8514
VEGLIA_PUBLIC_URL=http://127.0.0.1:8514
# Set your actual https://mcp.example.com origin before public deployment.
# Allow direct LAN MCP only by explicitly adding its host:port (or host:*).
VEGLIA_MCP_ALLOWED_HOSTS=
VEGLIA_MCP_ALLOWED_ORIGINS=
VEGLIA_OAUTH_REDIRECT_URIS=

# Temporary rotation support: old value stops working at this Unix timestamp.
# VEGLIA_PHONE_TOKEN_PREVIOUS=
# VEGLIA_PHONE_TOKEN_PREVIOUS_UNTIL=0
# VEGLIA_SENSOR_TOKEN_PREVIOUS=
# VEGLIA_SENSOR_TOKEN_PREVIOUS_UNTIL=0
# VEGLIA_MCP_TOKEN_PREVIOUS=
# VEGLIA_MCP_TOKEN_PREVIOUS_UNTIL=0
